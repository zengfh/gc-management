# Server runtime secrets. Copy to a local/private environment file or systemd EnvironmentFile.
# Do not commit real values.

# AI-assisted bulk import. Configure one or more providers.
GC_AI_GOOGLE_API_KEY=
GC_AI_OPENROUTER_API_KEY=
GC_AI_GROQ_API_KEY=

# Optional model overrides. Leave blank to let the app refresh model choices daily.
GC_AI_GOOGLE_MODEL=
GC_AI_OPENROUTER_MODEL=
GC_AI_GROQ_MODEL=

# Optional OpenRouter key used only for free-model discovery if GC_AI_OPENROUTER_API_KEY is absent.
# The app does not use this key for parsing completions.
GC_AI_OPENROUTER_DISCOVERY_API_KEY=
