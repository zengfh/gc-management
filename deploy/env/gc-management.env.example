NODE_ENV=production
PORT=3001
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-long-random-session-secret
GC_DB_PATH=/var/lib/gc-management/gcmanager.db
APP_ORIGIN=https://giftcards.example.com

GC_SERVE_STATIC=true
GC_TRUST_PROXY=true
GC_SESSION_COOKIE_SECURE=true
GC_DEPLOYMENT_MODE=single-node

GC_PLAINTEXT_EXPORT_ENABLED=false
GC_FEATURE_RAW_DATABASE_EXPORT=false
GC_FEATURE_CSV_IMPORT=true
GC_FEATURE_REFERENCE_VALUE_HINTS=true
GC_REQUEST_LOGS=true
GC_METRICS_TOKEN=replace-with-a-long-random-metrics-token

# Expiration email notifications.
# The app notifies owner/admin users with email addresses at 28, 21, 14, 7, 5, 4, 3, 2, and 1 days before card expiration.
# For month/year prepaid expirations such as 11/2026, the expiration date is treated as 2026-11-01.
GC_EXPIRATION_NOTIFICATIONS_ENABLED=true
GC_NOTIFICATION_FROM_EMAIL=Gift Card Manager <notifications@giftcards.example.com>
GC_SMTP_HOST=smtp.example.com
GC_SMTP_PORT=587
GC_SMTP_SECURE=false
GC_SMTP_USER=replace-with-smtp-user
GC_SMTP_PASS=replace-with-smtp-password
# Optional override when owner/admin users do not have email addresses in the app.
# GC_NOTIFICATION_RECIPIENT_EMAIL=admin@example.com
# Test-only outbox transport. Do not use for production email delivery.
# GC_NOTIFICATION_OUTBOX_PATH=/var/lib/gc-management/notification-outbox.jsonl

# Optional external error reporting.
# GC_ERROR_REPORT_URL=https://errors.example.com/report
# GC_ERROR_REPORT_TOKEN=replace-with-a-long-random-error-token

# Temporary SSH-tunnel testing without TLS only:
# GC_SESSION_COOKIE_SECURE=false
# APP_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
